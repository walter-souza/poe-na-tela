PORT=3001

# --- LiveKit ---
# Local: ws://127.0.0.1:7880 com devkey/secret (infra/local). Produção: chaves do ~/app-stack/.env da VPS.
LIVEKIT_URL=ws://127.0.0.1:7880
# URL que o backend usa para a API do LiveKit (padrão: LIVEKIT_URL com http/https).
# LIVEKIT_INTERNAL_URL=http://127.0.0.1:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret

# --- MediaMTX (streams do OBS / app desktop) ---
# API de controle do MediaMTX e URL pública de playback WHEP devolvida aos espectadores.
MEDIAMTX_API_URL=http://127.0.0.1:9997
# STREAM_URL=https://stream.exemplo.com   (vazio = VPS de produção)

# --- Modo de Manutenção ---
# Defina como true para ativar o modo de manutenção
MAINTENANCE_MODE=false
MAINTENANCE_MESSAGE="Estamos realizando melhorias programadas. Voltaremos em breve!"
# Acesso durante a manutencao: gere um valor aleatorio (>=16 caracteres), ex.: openssl rand -hex 24.
# Vazio = sem acesso de manutencao.
ADMIN_BYPASS_TOKEN=

# Buffer de vozes para clipes (so RAM, so de quem ativou o clipe). CLIP_BUFFER=0 desliga.
# CLIP_DEBUG=1 expoe rotas de depuracao que servem audio da sala sem autenticacao: NUNCA em producao.
CLIP_BUFFER=1
CLIP_DEBUG=0
# Clipes prontos (video do cliente + vozes do buffer): TTL em minutos, pasta temporaria e ajuste de sincronia das vozes (ms).
# CLIP_TTL_MIN=30
# CLIP_DIR=/tmp/poe-clips
# CLIP_VOICE_DELAY_MS=0
# FFMPEG_PATH=/usr/bin/ffmpeg   (padrao: binario do pacote ffmpeg-static)
