PORT=3001

# --- LiveKit Cloud Credentials ---
# Obtenha estas credenciais gratuitamente em: https://cloud.livekit.io
LIVEKIT_URL=wss://SEU-PROJETO.livekit.cloud
LIVEKIT_API_KEY=SUA_API_KEY
LIVEKIT_API_SECRET=SUA_API_SECRET

# --- Modo de Manutenção ---
# Defina como true no Render para ativar o modo de manutenção instantaneamente
MAINTENANCE_MODE=false
MAINTENANCE_MESSAGE="Estamos realizando melhorias programadas. Voltaremos em breve!"
# Sem esta variável o bypass de manutenção fica desativado. Use um valor longo e aleatório.
ADMIN_BYPASS_TOKEN=

# Origens extras permitidas pelo CORS (separadas por vírgula). Já incluídas: Vercel (prod/dev) e localhost.
# ALLOWED_ORIGINS=https://meu-dominio.com

# Segredo opcional do webhook do MediaMTX (header x-webhook-secret ou ?secret=). Se definido, o webhook o exige.
# MEDIAMTX_WEBHOOK_SECRET=
# Intervalo (ms) do monitor de reconciliacao de streams. Padrao: 15000
# MEDIAMTX_RECONCILE_MS=15000
