PORT=3001

# --- LiveKit Cloud Credentials ---
# Obtenha estas credenciais gratuitamente em: https://cloud.livekit.io
LIVEKIT_URL=wss://SEU-PROJETO.livekit.cloud
LIVEKIT_API_KEY=SUA_API_KEY
LIVEKIT_API_SECRET=SUA_API_SECRET

# --- Modo de Manutenção ---
# Defina como true no Render para ativar o modo de manutenção instantaneamente
MAINTENANCE_MODE=false
MAINTENANCE_MESSAGE="Estamos realizando melhorias programadas. Voltaremos em breve!"
ADMIN_BYPASS_TOKEN=admin_preview

# Buffer de vozes para clipes (so RAM, so de quem ativou o clipe). CLIP_BUFFER=0 desliga.
# CLIP_DEBUG=1 expoe rotas de depuracao que servem audio da sala sem autenticacao: NUNCA em producao.
CLIP_BUFFER=1
CLIP_DEBUG=0
# Clipes prontos (video do cliente + vozes do buffer): TTL em minutos, pasta temporaria e ajuste de sincronia das vozes (ms).
# CLIP_TTL_MIN=30
# CLIP_DIR=/tmp/poe-clips
# CLIP_VOICE_DELAY_MS=0
# FFMPEG_PATH=/usr/bin/ffmpeg   (padrao: binario do pacote ffmpeg-static)
