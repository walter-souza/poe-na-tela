{
  "name": "poe-na-tela",
  "version": "1.18.3",
  "private": true,
  "description": "Põe na Tela! — Plataforma de streaming de jogos em 60 FPS para amigos",
  "scripts": {
    "dev:server": "cd server && npm run dev",
    "dev:client": "cd client && npm run dev",
    "dev": "concurrently -n \"SERVER,CLIENT\" -c \"blue,green\" \"npm run dev:server\" \"npm run dev:client\"",
    "build:server": "cd server && npm run build",
    "build:client": "cd client && npm run build",
    "build": "npm run build:server && npm run build:client",
    "docker:up": "docker compose -f infra/local/docker-compose.yml up -d",
    "docker:down": "docker compose -f infra/local/docker-compose.yml down",
    "docker:logs": "docker compose -f infra/local/docker-compose.yml logs -f",
    "dev:desktop": "cd desktop && npm run dev",
    "build:desktop": "cd desktop && npm run fetch:ffmpeg && npm run build"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
