# URL da API do backend.
# Vazio = mesma origem (/api), que é o caso da Vercel (client/vercel.json reescreve para a VPS).
# Para desenvolvimento local fora do Vite: VITE_API_URL=http://localhost:3001
VITE_API_URL=

# Host:porta do ingest SRT do MediaMTX (OBS e app desktop). Vazio = VPS de produção.
# VITE_SRT_HOST=srt.exemplo.com:8890

# Modo de manutenção no front (true/1).
# VITE_MAINTENANCE_MODE=false
