# Exemplo de configuração de URL da API do backend
# Para desenvolvimento local, deixe em branco ou use:
# VITE_API_URL=http://localhost:3001
# Para produção, aponte para o domínio do seu servidor:
VITE_API_URL=https://api.exemplo.com

# Supabase Auth & Realtime
VITE_SUPABASE_URL=https://seu-projeto.supabase.co
VITE_SUPABASE_ANON_KEY=sua-anon-key-aqui

# Google Identity Services (Client ID público para login nativo com domínio próprio)
VITE_GOOGLE_CLIENT_ID=563489534853-npigrhgtcpmb7le5g7c2lleld19ha9r0.apps.googleusercontent.com

# Transmissão via OBS (botão Link OBS e lista de streams do MediaMTX). Desligada por padrão.
# VITE_ENABLE_OBS=true
