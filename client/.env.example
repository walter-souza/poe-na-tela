# URL base da API do StreamPulse (deixe vazio em desenvolvimento para usar o proxy local do Vite)
# Em produção (Vercel), defina como a URL do seu backend no Render (ex: https://streampulse-api.onrender.com/api)
VITE_API_URL=

# Opcional: Ativação direta no Frontend (caso queira travar antes mesmo da resposta do backend)
VITE_MAINTENANCE_MODE=false
VITE_MAINTENANCE_MESSAGE="Estamos realizando melhorias programadas. Voltaremos em breve!"
